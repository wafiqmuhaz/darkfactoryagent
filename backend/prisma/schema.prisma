// ─── Dark Factory AI Agent System — Database Schema ─────────────────
// SQLite for local development. Switch datasource to PostgreSQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ──────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects     Project[]

  @@map("users")
}

// ─── Projects ───────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  path        String                // Local filesystem path to the project
  repoUrl     String?  @map("repo_url") // GitHub/GitLab remote URL
  branch      String   @default("main")
  language    String?               // Primary language (e.g., "typescript")
  framework   String?               // Framework (e.g., "react", "express")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks       Task[]
  artifacts   Artifact[]
  agentRuns   AgentRun[]

  @@map("projects")
}

// ─── Tasks ──────────────────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  title         String
  description   String?
  status        String     @default("backlog") // backlog, todo, in_progress, review, done, failed
  priority      String     @default("medium")  // low, medium, high, critical
  type          String     @default("feature")  // feature, bug, refactor, test, docs
  complexity    Int        @default(1)          // 1-5 story points
  assignedAgent String?    @map("assigned_agent") // Agent ID assigned to this task
  parentId      String?    @map("parent_id")      // For sub-task relationships
  labels        String?                            // Comma-separated labels
  dueDate       DateTime?  @map("due_date")
  startedAt     DateTime?  @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  projectId     String     @map("project_id")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parent        Task?      @relation("SubTasks", fields: [parentId], references: [id])
  subTasks      Task[]     @relation("SubTasks")
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  comments      Comment[]

  @@index([projectId, status])
  @@index([assignedAgent])
  @@map("tasks")
}

// ─── Comments ───────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  author    String                    // "user" or agent ID
  createdAt DateTime @default(now()) @map("created_at")

  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─── Artifacts ──────────────────────────────────────────────────────

model Artifact {
  id        String   @id @default(uuid())
  type      String                    // code, spec, test, review, doc, pr
  name      String
  content   String                    // Content or file path
  metadata  String?                   // JSON string for flexible metadata
  createdAt DateTime @default(now()) @map("created_at")

  taskId    String?  @map("task_id")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  agentRunId String? @map("agent_run_id")
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@map("artifacts")
}

// ─── Skills ─────────────────────────────────────────────────────────

model Skill {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  category    String                   // browser, mobile, filesystem, api, custom
  agentType   String  @map("agent_type") // Which agent types can use this skill
  parameters  String?                  // JSON schema for parameters
  isEnabled   Boolean @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("skills")
}

// ─── Agent Runs ─────────────────────────────────────────────────────

model AgentRun {
  id          String    @id @default(uuid())
  agentType   String    @map("agent_type")  // chief-of-staff, spec-writer, code-writer, etc.
  status      String    @default("pending")  // pending, running, completed, failed, cancelled
  input       String?                        // JSON input parameters
  output      String?                        // JSON output / result
  logs        String?                        // Execution logs
  error       String?                        // Error message if failed
  tokensUsed  Int       @default(0) @map("tokens_used")
  cost        Float     @default(0)          // Estimated cost in USD
  duration    Int       @default(0)          // Duration in seconds
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  taskId      String?   @map("task_id")
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId   String?   @map("project_id")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  artifacts   Artifact[]

  @@index([agentType, status])
  @@map("agent_runs")
}

// ─── Metrics ────────────────────────────────────────────────────────

model Metric {
  id          String   @id @default(uuid())
  category    String                     // cost, performance, quality, productivity
  name        String                     // e.g., "tokens_used", "tasks_completed"
  value       Float
  unit        String?                    // e.g., "tokens", "usd", "seconds", "percent"
  metadata    String?                    // JSON for extra context
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([category, name, recordedAt])
  @@map("metrics")
}

// ─── Sprint 17: Developer Ecosystem ─────────────────────────────────

// 6.11 Plugin Marketplace
model Plugin {
  id           String   @id @default(uuid())
  name         String   @unique
  displayName  String   @map("display_name")
  description  String?
  version      String   @default("1.0.0")
  author       String
  category     String                    // skill, integration, theme, agent
  entrypoint   String                    // path or URL to plugin code
  configSchema String?  @map("config_schema") // JSON schema for config
  isPublished  Boolean  @default(false) @map("is_published")
  isEnabled    Boolean  @default(true)  @map("is_enabled")
  downloads    Int      @default(0)
  rating       Float    @default(0)
  ratingCount  Int      @default(0)     @map("rating_count")
  tags         String?                  // comma-separated
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  installations PluginInstall[]

  @@map("plugins")
}

model PluginInstall {
  id        String   @id @default(uuid())
  config    String?  // JSON config blob
  installedAt DateTime @default(now()) @map("installed_at")

  pluginId  String   @map("plugin_id")
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  teamId    String?  @map("team_id")
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@map("plugin_installs")
}

// 6.12 Custom Skill Studio
model CustomSkill {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  prompt      String                    // System prompt / instruction
  parameters  String?                  // JSON schema for parameters
  model       String?                  // Preferred AI model override
  examples    String?                  // JSON array of example I/O pairs
  isPublic    Boolean  @default(false) @map("is_public")
  testResults String?  @map("test_results") // JSON last test run results
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  authorId    String   @map("author_id")

  @@map("custom_skills")
}

// 6.13 Team Collaboration
model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  plan        String   @default("free") // free, pro, enterprise
  maxMembers  Int      @default(5)      @map("max_members")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  members     TeamMember[]
  workspaces  Workspace[]
  plugins     PluginInstall[]
  invoices    Invoice[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  role      String   @default("member") // owner, admin, member, viewer
  joinedAt  DateTime @default(now()) @map("joined_at")

  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id")

  @@unique([teamId, userId])
  @@map("team_members")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  settings    String?  // JSON workspace settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  teamId      String   @map("team_id")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

// 6.14 Enterprise: Billing
model Invoice {
  id          String   @id @default(uuid())
  amount      Float
  currency    String   @default("USD")
  status      String   @default("pending") // pending, paid, failed, refunded
  description String?
  period      String?  // e.g., "2025-07"
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  teamId      String   @map("team_id")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// 6.15 Integration Hub
model Integration {
  id          String   @id @default(uuid())
  name        String                    // e.g., "github", "jira", "slack", "linear"
  displayName String   @map("display_name")
  type        String                    // vcs, pm, chat, ci, storage
  config      String?                  // Encrypted JSON config
  isActive    Boolean  @default(true)  @map("is_active")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("integrations")
}
