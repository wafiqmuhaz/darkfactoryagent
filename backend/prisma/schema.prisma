// ─── Dark Factory AI Agent System — Database Schema ─────────────────
// SQLite for local development. Switch datasource to PostgreSQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Users ──────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects     Project[]

  @@map("users")
}

// ─── Projects ───────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  path        String                // Local filesystem path to the project
  repoUrl     String?  @map("repo_url") // GitHub/GitLab remote URL
  branch      String   @default("main")
  language    String?               // Primary language (e.g., "typescript")
  framework   String?               // Framework (e.g., "react", "express")
  adapterType String?  @map("adapter_type") // "claude-code" | "codex" | etc.
  adapterModel String? @map("adapter_model") // "auto" or a specific model id
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ownerId     String   @map("owner_id")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks       Task[]
  artifacts   Artifact[]
  agentRuns   AgentRun[]
  routines    Routine[]
  companyProjects ProjectCompany[]

  @@map("projects")
}

// ─── Tasks ──────────────────────────────────────────────────────────

model Task {
  id            String     @id @default(uuid())
  title         String
  description   String?
  status        String     @default("backlog") // backlog, todo, in_progress, review, done, failed
  priority      String     @default("medium")  // low, medium, high, critical
  type          String     @default("feature")  // feature, bug, refactor, test, docs
  complexity    Int        @default(1)          // 1-5 story points
  assignedAgent String?    @map("assigned_agent") // Agent ID assigned to this task
  parentId      String?    @map("parent_id")      // For sub-task relationships
  labels        String?                            // Comma-separated labels
  dueDate       DateTime?  @map("due_date")
  startedAt     DateTime?  @map("started_at")
  completedAt   DateTime?  @map("completed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  projectId     String     @map("project_id")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parent        Task?      @relation("SubTasks", fields: [parentId], references: [id])
  subTasks      Task[]     @relation("SubTasks")
  artifacts     Artifact[]
  agentRuns     AgentRun[]
  comments      Comment[]

  @@index([projectId, status])
  @@index([assignedAgent])
  @@map("tasks")
}

// ─── Comments ───────────────────────────────────────────────────────

model Comment {
  id        String   @id @default(uuid())
  content   String
  author    String                    // "user" or agent ID
  createdAt DateTime @default(now()) @map("created_at")

  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("comments")
}

// ─── Artifacts ──────────────────────────────────────────────────────

model Artifact {
  id        String   @id @default(uuid())
  type      String                    // code, spec, test, review, doc, pr
  name      String
  content   String                    // Content or file path
  metadata  String?                   // JSON string for flexible metadata
  createdAt DateTime @default(now()) @map("created_at")

  taskId    String?  @map("task_id")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  agentRunId String? @map("agent_run_id")
  agentRun   AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@map("artifacts")
}

// ─── Legacy Skills (replaced by Skills Store) ─────────────────────

model LegacySkill {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  category    String                   // browser, mobile, filesystem, api, custom
  agentType   String  @map("agent_type")
  parameters  String?                  // JSON schema for parameters
  isEnabled   Boolean @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("legacy_skills")
}

// ─── Agent Runs ─────────────────────────────────────────────────────

model AgentRun {
  id          String    @id @default(uuid())
  agentType   String    @map("agent_type")  // chief-of-staff, spec-writer, code-writer, etc.
  status      String    @default("pending")  // pending, running, completed, failed, cancelled
  input       String?                        // JSON input parameters
  output      String?                        // JSON output / result
  logs        String?                        // Execution logs
  error       String?                        // Error message if failed
  tokensUsed  Int       @default(0) @map("tokens_used")
  cost        Float     @default(0)          // Estimated cost in USD
  duration    Int       @default(0)          // Duration in seconds
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  taskId      String?   @map("task_id")
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  projectId   String?   @map("project_id")
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  artifacts   Artifact[]

  @@index([agentType, status])
  @@map("agent_runs")
}

// ─── Metrics ────────────────────────────────────────────────────────

model Metric {
  id          String   @id @default(uuid())
  category    String                     // cost, performance, quality, productivity
  name        String                     // e.g., "tokens_used", "tasks_completed"
  value       Float
  unit        String?                    // e.g., "tokens", "usd", "seconds", "percent"
  metadata    String?                    // JSON for extra context
  recordedAt  DateTime @default(now()) @map("recorded_at")

  @@index([category, name, recordedAt])
  @@map("metrics")
}

// ─── Sprint 17: Developer Ecosystem ─────────────────────────────────

// 6.11 Plugin Marketplace
model Plugin {
  id           String   @id @default(uuid())
  name         String   @unique
  displayName  String   @map("display_name")
  description  String?
  version      String   @default("1.0.0")
  author       String
  category     String                    // skill, integration, theme, agent
  entrypoint   String                    // path or URL to plugin code
  configSchema String?  @map("config_schema") // JSON schema for config
  isPublished  Boolean  @default(false) @map("is_published")
  isEnabled    Boolean  @default(true)  @map("is_enabled")
  downloads    Int      @default(0)
  rating       Float    @default(0)
  ratingCount  Int      @default(0)     @map("rating_count")
  tags         String?                  // comma-separated
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  installations PluginInstall[]

  @@map("plugins")
}

model PluginInstall {
  id        String   @id @default(uuid())
  config    String?  // JSON config blob
  installedAt DateTime @default(now()) @map("installed_at")

  pluginId  String   @map("plugin_id")
  plugin    Plugin   @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  teamId    String?  @map("team_id")
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@map("plugin_installs")
}

// 6.12 Custom Skill Studio
model CustomSkill {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  prompt      String                    // System prompt / instruction
  parameters  String?                  // JSON schema for parameters
  model       String?                  // Preferred AI model override
  examples    String?                  // JSON array of example I/O pairs
  isPublic    Boolean  @default(false) @map("is_public")
  testResults String?  @map("test_results") // JSON last test run results
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  authorId    String   @map("author_id")

  @@map("custom_skills")
}

// 6.13 Team Collaboration
model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  plan        String   @default("free") // free, pro, enterprise
  maxMembers  Int      @default(5)      @map("max_members")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  members     TeamMember[]
  workspaces  Workspace[]
  plugins     PluginInstall[]
  invoices    Invoice[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  role      String   @default("member") // owner, admin, member, viewer
  joinedAt  DateTime @default(now()) @map("joined_at")

  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id")

  @@unique([teamId, userId])
  @@map("team_members")
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  settings    String?  // JSON workspace settings
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  teamId      String   @map("team_id")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("workspaces")
}

// 6.14 Enterprise: Billing
model Invoice {
  id          String   @id @default(uuid())
  amount      Float
  currency    String   @default("USD")
  status      String   @default("pending") // pending, paid, failed, refunded
  description String?
  period      String?  // e.g., "2025-07"
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime @default(now()) @map("created_at")

  teamId      String   @map("team_id")
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

// 6.15 Integration Hub
model Integration {
  id          String   @id @default(uuid())
  name        String                    // e.g., "github", "jira", "slack", "linear"
  displayName String   @map("display_name")
  type        String                    // vcs, pm, chat, ci, storage
  config      String?                  // Encrypted JSON config
  isActive    Boolean  @default(true)  @map("is_active")
  lastSyncAt  DateTime? @map("last_sync_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("integrations")
}

// ─── Companies (Paperclip-aligned onboarding) ─────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  mission   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  agents    Agent[]
  projects  ProjectCompany[]
  invites   Invite[]
  members   CompanyMember[]

  @@map("companies")
}

model ProjectCompany {
  id         String   @id @default(uuid())
  localPath  String   @map("local_path")   // Local filesystem path to project repo
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([companyId, projectId])
  @@map("project_companies")
}

// ─── Agents (extended for onboarding) ────────────────────────────

model Agent {
  id         String     @id @default(uuid())
  name       String                    // e.g., "Chief of Staff"
  type       String     @default("chief-of-staff") // chief-of-staff, spec-writer, code-writer, etc.
  role       String?                   // e.g., "orchestrator"
  skills     String?                   // JSON array of skill IDs
  config     String?                   // JSON config (temperature, maxTokens)
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt     @map("updated_at")

  companyId  String     @map("company_id")
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  adapterId  String?    @map("adapter_id")
  adapter    Adapter?   @relation(fields: [adapterId], references: [id])

  @@map("agents")
}

// ─── Adapters (Claude Code CLI, Codex, etc.) ──────────────────────

model Adapter {
  id          String     @id @default(uuid())
  name        String     @unique        // "claude-code", "codex", etc.
  displayName String     @map("display_name")
  type        String     @default("cli") // "cli", "api"
  description String?
  command     String?                   // CLI command path
  envVars     String?                   // JSON of required env vars
  version     String?                   // Detected CLI version
  runtime     String?                   // "local" | "docker" | "none" — where the CLI was found
  models      String?                   // JSON array of supported models
  isConnected Boolean    @default(false) @map("is_connected")
  lastProbeAt DateTime?  @map("last_probe_at")
  probeStatus String?                   // "ready", "error", "not_tested"
  probeError  String?                   // Last probe error message
  config      String?                   // JSON config for adapter
  isDefault   Boolean    @default(false) @map("is_default")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt     @map("updated_at")

  agents      Agent[]

  @@map("adapters")
}

// ─── Skills Store ─────────────────────────────────────────────────

model Skill {
  id            String     @id @default(uuid())
  name          String     @unique
  displayName   String     @map("display_name")
  description   String?
  category      String     @default("custom") // browser, mobile, filesystem, api, custom
  version       String     @default("1.0.0")
  author        String     @default("dark-factory")
  icon          String?
  tags          String?
  codePath      String?    @map("code_path")
  entrypoint    String?    @default("index.js")
  configSchema  String?    @map("config_schema") // JSON schema
  isInstalled   Boolean    @default(false) @map("is_installed")
  isEnabled     Boolean    @default(true)  @map("is_enabled")
  isBuiltIn     Boolean    @default(false) @map("is_built_in")
  installedAt   DateTime?  @map("installed_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt     @map("updated_at")

  @@map("skills_store")
}

// ─── Routines (recurring scheduled tasks) ─────────────────────────

model Routine {
  id            String     @id @default(uuid())
  name          String
  description   String?
  schedule      String                   // Cron expression
  timezone      String     @default("UTC")
  taskTemplate  String?                  // JSON template for task creation
  isActive      Boolean    @default(true) @map("is_active")
  lastRunAt     DateTime?  @map("last_run_at")
  nextRunAt     DateTime?  @map("next_run_at")
  runCount      Int        @default(0)   @map("run_count")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt    @map("updated_at")

  projectId     String     @map("project_id")
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  agentId       String?    @map("agent_id")
  skillId       String?    @map("skill_id")

  runs          RoutineRun[]

  @@map("routines")
}

model RoutineRun {
  id          String     @id @default(uuid())
  status      String     @default("pending") // pending, running, completed, failed
  output      String?
  error       String?
  duration    Int        @default(0)         // in seconds
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  routineId   String     @map("routine_id")
  routine     Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@map("routine_runs")
}

// ─── Cost Tracking ────────────────────────────────────────────────

model CostLedger {
  id          String   @id @default(uuid())
  amount      Float
  currency    String   @default("USD")
  description String?
  category    String   @default("inference") // inference, api, storage, compute
  referenceId String?  @map("reference_id")  // agent_run_id, task_id, etc.
  referenceType String? @map("reference_type") // agent_run, task, routine
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("cost_ledger")
}

model Budget {
  id        String   @id @default(uuid())
  name      String   @default("Monthly Budget")
  amount    Float    @default(10.00)       // USD limit
  period    String   @default("monthly")   // monthly, weekly, custom
  startDate DateTime @default(now()) @map("start_date")
  endDate   DateTime?
  alert50   Boolean  @default(true)  @map("alert_50")
  alert80   Boolean  @default(true)  @map("alert_80")
  alert100  Boolean  @default(true)  @map("alert_100")
  isActive  Boolean  @default(true)  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@map("budgets")
}

// ─── Activity Timeline ────────────────────────────────────────────

model Activity {
  id          String   @id @default(uuid())
  type        String                    // agent_run, task_status, system, routine, skill, adapter
  message     String
  metadata    String?                   // JSON extra data
  agentId     String?  @map("agent_id")
  taskId      String?  @map("task_id")
  projectId   String?  @map("project_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type, createdAt])
  @@map("activities")
}

// ─── Onboarding Session (persist mid-wizard state) ────────────────

model OnboardingSession {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  currentStep Int      @default(0)   @map("current_step")
  companyName String?  @map("company_name")
  mission     String?
  missionMode String?  @map("mission_mode") // "i-know" or "help-me"
  agentName   String?  @map("agent_name")
  adapterId   String?  @map("adapter_id")
  adapterName String?  @map("adapter_name")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt     @map("updated_at")

  @@map("onboarding_sessions")
}

// ─── Secrets (encrypted env vars) ─────────────────────────────────

model Secret {
  id        String   @id @default(uuid())
  key       String                   // e.g., "ANTHROPIC_API_KEY"
  value     String                   // Encrypted value
  scope     String   @default("user") // user, project, global
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  @@unique([key, scope])
  @@map("secrets")
}

// ─── Company Invites ──────────────────────────────────────────────

model Invite {
  id        String   @id @default(uuid())
  email     String
  role      String   @default("member") // owner, admin, operator, viewer
  token     String   @unique
  status    String   @default("pending") // pending, accepted, expired, revoked
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invitedBy String   @map("invited_by")

  @@map("invites")
}

// ─── Company Members ──────────────────────────────────────────────

model CompanyMember {
  id        String   @id @default(uuid())
  role      String   @default("owner") // owner, admin, operator, viewer
  joinedAt  DateTime @default(now()) @map("joined_at")

  companyId String   @map("company_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId    String   @map("user_id")

  @@unique([companyId, userId])
  @@map("company_members")
}
